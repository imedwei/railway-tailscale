{
  "$schema": "https://railway.app/railway.schema.json",
  "deploy": {
    "image": "tailscale/tailscale:stable",
    "startCommand": "/bin/sh -c \"export TS_HOSTNAME=$(echo \\\"${RAILWAY_PROJECT_NAME}-${RAILWAY_ENVIRONMENT_NAME}\\\" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g' | sed 's/--*/-/g') && exec /usr/local/bin/containerboot\"",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "runtime": "V2",
    "numReplicas": 1,
    "region": "us-west1",
    "serverless": {
      "enabled": true
    },
    "resourceLimits": {
      "vCPUs": 1,
      "memoryMB": 1024
    }
  },
  "variables": {
    "TS_ROUTES": "fd12::/16",
    "TS_STATE_DIR": "{{RAILWAY_VOLUME_MOUNT_PATH}}/tailscale",
    "TS_AUTHKEY": {
      "required": true,
      "description": "Tailscale authentication key. Get one from https://login.tailscale.com/admin/settings/keys"
    }
  },
  "volumes": [
    {
      "name": "tailscale-state",
      "mountPath": "/var/lib/tailscale"
    }
  ]
}